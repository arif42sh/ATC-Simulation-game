# ===============================================
# SkyATC AI - Environment Configuration
# ===============================================

# Google Gemini API Settings (Free Tier via Google AI Studio)
# GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

# Database Settings (MySQL primary with automatic SQLite fallback)
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=SKYATC
SQLITE_PATH=data/skyatc.db

# Simulation Settings
HITL_TIMEOUT_SECONDS=10.0
SIMULATION_FPS=60
DEFAULT_SCENARIO=normal_landing
